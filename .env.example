APP_NAME="Plant Coaction Affiliate AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=affiliate_ai_tiktok
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=plant_coaction_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@plantcoaction.local"
MAIL_FROM_NAME="${APP_NAME}"

# AI Multi-Provider & Fallback
AI_DEFAULT_PROVIDER=openrouter
AI_FALLBACK_ENABLED=false

# OpenRouter AI Provider (kosongkan di repository, isi di .env lokal atau via Dashboard)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT=30

# Google Gemini Developer API (API Key dari https://aistudio.google.com/apikey — terpisah dari langganan Antigravity)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=1

# Text-to-Speech Default Provider (google_gemini_tts atau google_cloud_tts)
TTS_DEFAULT_PROVIDER=google_gemini_tts
# Gemini TTS menggunakan ulang GEMINI_API_KEY di atas (tidak perlu Google Cloud Billing)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_TIMEOUT=45
GEMINI_TTS_MAX_RETRIES=1

# Google Cloud Text-to-Speech (opsional alternatif — memerlukan Google Cloud Console)
GOOGLE_TTS_API_KEY=
GOOGLE_CLOUD_TTS_CREDENTIALS=
GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1
GOOGLE_TTS_LANGUAGE_CODE=id-ID
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_VOLUME_GAIN_DB=0.0

# Remotion & FFmpeg
REMOTION_PROJECT_PATH=remotion
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# TikTok Developer API (Login Kit & Display API v2 — https://developers.tiktok.com/)
# OAuth Platform: web (prioritas untuk aplikasi Laravel via HTTPS/ngrok) atau desktop (wajib PKCE S256)
TIKTOK_OAUTH_PLATFORM=web
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-https-domain-or-ngrok/dashboard/tiktok/callback
TIKTOK_OAUTH_SCOPES=user.info.basic
TIKTOK_ENVIRONMENT=sandbox

# TikTok Shop Partner Center — Affiliate Creator API (Terpisah dari Login Kit)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_REGION=ID

VITE_APP_NAME="${APP_NAME}"
